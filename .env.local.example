# Firebase Cloud Function that accepts booking requests (sheet and/or payment).
# Include the function name, no trailing slash. Inlined into the static bundle
# at build time, so it MUST be present for `npm run build`.
#   POST {url}/new
#   GET  {url}/{bookingId}
NEXT_PUBLIC_BOOKINGS_API_URL=https://asia-south1-globalairtravels-9651f.cloudfunctions.net/bookings

# ── Firebase Web App config (client-side Auth + Firestore) ──
# These NEXT_PUBLIC_* values are public identifiers (safe to ship in the bundle).
# Copy this file to .env.local and fill from Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration.
# If apiKey/projectId are absent the app simply hides login (no crash).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=globalairtravels-9651f.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=globalairtravels-9651f
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=globalairtravels-9651f.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
