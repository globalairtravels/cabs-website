# ── Google Sheet (required while firestore/config.checkout.json sheet.enabled is true) ──
# Create a Google Cloud service account, enable the Sheets API, share the
# spreadsheet with that account as Editor, then store the JSON key as a secret:
#   firebase functions:secrets:set GOOGLE_SHEETS_CREDENTIALS
# Paste the full service-account JSON.
#
# Spreadsheet id is the long id in the Sheet URL:
#   firebase functions:secrets:set GOOGLE_SHEETS_SPREADSHEET_ID
# Local emulator only — production reads the secret above:
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=BookingRequests

# ── PhonePe Standard Checkout v2 (only required after gateways.phonepe.enabled) ──
#   firebase functions:secrets:set PHONEPE_CLIENT_ID
#   firebase functions:secrets:set PHONEPE_CLIENT_SECRET
#   firebase functions:secrets:set PHONEPE_CLIENT_VERSION
#   firebase functions:secrets:set PHONEPE_WEBHOOK_USERNAME
#   firebase functions:secrets:set PHONEPE_WEBHOOK_PASSWORD
# Webhook URL to register in the PhonePe dashboard (SHA auth, not HMAC):
#   https://asia-south1-globalairtravels-9651f.cloudfunctions.net/bookings/webhooks/phonepe

# ── Razorpay (only required after gateways.razorpay.enabled) ──
# Adapter is a stub until Checkout.js or Payment Links is implemented.

# Environment shared across gateways: "sandbox" (default) or "production".
PAYMENTS_ENV=sandbox

# Deployed website URL — used to build the redirectUrl the gateway sends the customer back to.
SITE_URL=https://globalairtravels.com
